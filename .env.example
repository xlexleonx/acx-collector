# Public local address used by the browser UI
ACX_BIND_PORT=8088
POSTGRES_DB=acx_collector
POSTGRES_USER=acx
POSTGRES_PASSWORD=change-this-to-a-long-random-password
DATABASE_URL=postgresql+psycopg://acx:change-this-to-a-long-random-password@postgres:5432/acx_collector

# Generate with: openssl rand -base64 32
ACX_MASTER_KEY=replace-with-a-fernet-key

# The Portal URL, collector ID and token are configured by an administrator in
# the Collector UI: System -> Synchronization. They are encrypted in the local
# database and are deliberately not kept in this environment file.

# How long unsent telemetry may remain locally (days)
LOCAL_RETENTION_DAYS=30

